APP_NAME=IVENHUB
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://eventcek.com
FORCE_HTTPS=true

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u1234567_eventcek
DB_USERNAME=u1234567_user
DB_PASSWORD=password_database_hosting

# Drivers
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# Redis (Jika pakai)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (SMTP Hosting/Gmail)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=adzkiateknolombok@gmail.com
MAIL_PASSWORD=app_password_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@eventcek.com
MAIL_FROM_NAME="Admin IVENHUB"

# Midtrans (Pastikan switch ke Production keys)
MIDTRANS_SERVER_KEY=Mid-server-PRODUCTION-KEY
MIDTRANS_CLIENT_KEY=Mid-client-PRODUCTION-KEY
MIDTRANS_MERCHANT_ID=G978666976
MIDTRANS_IS_PRODUCTION=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://eventcek.com/auth/google/callback

# WhatsApp API
WHATSAPP_ENABLED=true
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_SENDER_NAME=IVEN-HUB
